# Maintainer: YagYz <https://github.com/YagYz>
pkgname=ydevdesk-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="YDevDesk — Homelab & Multi-Agent Desktop Command Center"
arch=('x86_64')
url="https://github.com/YagYz/YDevDesk"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'hicolor-icon-theme' 'libnotify')
provides=('ydevdesk')
conflicts=('ydevdesk')
source=("https://github.com/YagYz/YDevDesk/releases/download/v${pkgver}/ydevdesk_${pkgver}_amd64.deb")
sha256sums=('SKIP')

package() {
  bsdtar -xf "${srcdir}/data.tar.gz" -C "${pkgdir}/"

  # Wayland / NVIDIA beyaz ekran önlemi: ikiliyi ortam değişkeni ile sarmala
  if [ -f "${pkgdir}/usr/bin/ydevdesk" ]; then
    mv "${pkgdir}/usr/bin/ydevdesk" "${pkgdir}/usr/bin/ydevdesk-bin"
    cat > "${pkgdir}/usr/bin/ydevdesk" <<'EOF'
#!/bin/sh
export WEBKIT_DISABLE_DMABUF_RENDERER="${WEBKIT_DISABLE_DMABUF_RENDERER:-1}"
exec /usr/bin/ydevdesk-bin "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/ydevdesk"
  fi
}
